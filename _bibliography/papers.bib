@article{amiri2023indoor,
  title     = {Indoor Environment Learning via {RF}-Mapping},
  author    = {Amiri, Roohollah and Yerramalli, Srinivas and Yoo, Taesang and Hirzallah, Mohammed and Zorgui, Marwen and Prakash, Rajat and Zhang, Xiaoxia},
  journal   = {IEEE Journal on Selected Areas in Communications},
  volume    = {41},
  number    = {6},
  pages     = {1859--1872},
  year      = {2023},
  doi       = {10.1109/JSAC.2023.3273702},
  abbr      = {IEEE JSAC},
  selected  = {true},
  abstract  = {We propose an RF-mapping framework that enables a mobile agent to learn a rich representation of its indoor environment purely from radio frequency channel measurements, without requiring prior maps or labeled data. The system fuses 5G channel state information with neural network architectures to build environment-aware radio maps that support positioning and navigation tasks.}
}

@article{akgun2024digital,
  title     = {Advancing Next Generation Wireless Networks With Digital Twin: Construction, Validation, and Real-World Applications on an Indoor Over-the-Air Testbed},
  author    = {Akgun, Berk and Jolly, Aditya and Sachdev, Balwinder and Ravichandran, Divya and Amiri, Roohollah and Jain, Vikas and Jayabalan, Muruganandam and Chen, Yitao and Pathak, Hetal and Chande, Vinay and others},
  journal   = {IEEE Access},
  volume    = {12},
  pages     = {166298--166319},
  year      = {2024},
  doi       = {10.1109/ACCESS.2024.3493609},
  abbr      = {IEEE Access},
  selected  = {true},
  abstract  = {We present a comprehensive digital twin framework for next-generation wireless networks, covering construction, validation, and real-world deployment on an indoor over-the-air testbed. The system enables high-fidelity simulation of 5G/6G environments and supports AI-driven network optimization at scale.}
}

@inproceedings{ermolov2023neural,
  title     = {Neural {5G} Indoor Localization with {IMU} Supervision},
  author    = {Ermolov, Aleksandr and Kadambi, Shreya and Arnold, Maximilian and Hirzallah, Mohammed and Amiri, Roohollah and Singh, Deepak Singh Mahendar and Yerramalli, Srinivas and Dijkman, Daniel and Porikli, Fatih and Yoo, Taesang and Major, Bence},
  booktitle = {IEEE Global Communications Conference (GLOBECOM)},
  pages     = {3922--3927},
  year      = {2023},
  doi       = {10.1109/GLOBECOM54140.2023.10437705},
  abbr      = {GLOBECOM},
  selected  = {true},
  abstract  = {We propose a neural network approach for indoor localization in 5G networks that leverages IMU supervision during training, enabling accurate position estimation from radio signals alone at inference time. The method achieves sub-meter accuracy in challenging multipath environments.}
}

@inproceedings{kadambi2022neural,
  title     = {Neural {RF SLAM} for Unsupervised Positioning and Mapping with Channel State Information},
  author    = {Kadambi, Shreya and Behboodi, Arash and Soriaga, Joseph B. and Welling, Max and Amiri, Roohollah and Yerramalli, Srinivas and Yoo, Taesang},
  booktitle = {IEEE International Conference on Communications (ICC)},
  pages     = {3238--3244},
  year      = {2022},
  doi       = {10.1109/ICC45855.2022.9838367},
  abbr      = {ICC},
  selected  = {true},
  abstract  = {We introduce Neural RF SLAM, an unsupervised framework for simultaneous positioning and environment mapping using 5G channel state information. By combining neural implicit representations with SLAM principles, the system learns radio-frequency maps without any ground-truth position labels.}
}

@article{amiri2019reinforcement,
  title     = {Reinforcement Learning for Self Organization and Power Control of Two-Tier Heterogeneous Networks},
  author    = {Amiri, Roohollah and Almasi, Mojtaba Ahmadi and Andrews, Jeffrey G. and Mehrpouyan, Hani},
  journal   = {IEEE Transactions on Wireless Communications},
  volume    = {18},
  number    = {8},
  pages     = {3933--3947},
  year      = {2019},
  doi       = {10.1109/TWC.2019.2920848},
  abbr      = {IEEE TWC},
  abstract  = {We develop a reinforcement learning framework for joint self-organization and power control in two-tier heterogeneous cellular networks. The proposed distributed algorithm enables small cells to autonomously adapt their transmit power and activation state, improving network capacity and reducing interference without centralized coordination.}
}

@article{almasi2020mmwave,
  title     = {{mmWave} Lens-Based {MIMO} System for Suppressing Small-Scale Fading and Shadowing},
  author    = {Almasi, Mojtaba Ahmadi and Amiri, Roohollah and Jafarkhani, Hamid and Mehrpouyan, Hani},
  journal   = {IEEE Transactions on Wireless Communications},
  volume    = {19},
  number    = {8},
  pages     = {5292--5306},
  year      = {2020},
  doi       = {10.1109/TWC.2020.2991776},
  abbr      = {IEEE TWC},
  abstract  = {We design a millimeter-wave lens-based MIMO architecture that uses reconfigurable multi-beam antennas to simultaneously suppress small-scale fading and shadowing, enabling robust high-throughput communication for 5G and beyond.}
}

@inproceedings{amiri2020spatial,
  title     = {Spatial Indexing for System-Level Evaluation of {5G} Heterogeneous Cellular Networks},
  author    = {Amiri, Roohollah and Balevi, Eren and Andrews, Jeffrey G. and Mehrpouyan, Hani},
  booktitle = {IEEE Vehicular Technology Conference (VTC Fall)},
  year      = {2020},
  doi       = {10.1109/VTC2020-Fall49728.2020.9348595},
  abbr      = {VTC},
  abstract  = {We propose a spatial indexing method that dramatically accelerates large-scale system-level simulations of heterogeneous 5G networks, enabling efficient evaluation of scheduling, interference, and mobility management algorithms at realistic network densities.}
}

@inproceedings{amiri2018machine,
  title     = {A Machine Learning Approach for Power Allocation in {HetNets} Considering {QoS}},
  author    = {Amiri, Roohollah and Mehrpouyan, Hani and Fridman, Lev and Maleh, Richard and Wicks, Michael and Matolak, David},
  booktitle = {IEEE International Conference on Communications (ICC)},
  year      = {2018},
  doi       = {10.1109/ICC.2018.8422864},
  abbr      = {ICC},
  abstract  = {We propose a machine learning framework for power allocation in heterogeneous networks that jointly optimizes QoS satisfaction and spectral efficiency. The approach combines clustering and Q-learning to enable distributed, adaptive resource management without requiring global network state information.}
}

@inproceedings{amiri2018joint,
  title     = {Joint Power Allocation in Interference-Limited Networks via Distributed Coordinated Learning},
  author    = {Amiri, Roohollah and Mehrpouyan, Hani and Matolak, David and Elkashlan, Maged},
  booktitle = {IEEE International Conference on Communications (ICC)},
  year      = {2018},
  abbr      = {ICC},
  abstract  = {We develop a distributed multi-agent reinforcement learning algorithm for joint power allocation in dense interference-limited wireless networks, achieving near-optimal throughput without requiring centralized coordination or explicit channel state information exchange.}
}

